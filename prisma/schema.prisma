generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String @id @map("_id")
  name          String
  email         String @unique
  emailVerified Boolean @default(false)
  role          Role @default(AUTHOR)
  gender        Gender?
  phone         String
  image         String?
  address       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  articles      Article[]       @relation("EditorArticles")
  articleAuthors ArticleAuthor[]
  reviews       Review[]
  sessions      Session[]
  testimonials  Testimonial[]
}

model Session {
  id             String @id @map("_id")
  expiresAt      DateTime
  token          String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   User @relation(fields: [userId], references: [id])
}

model Account {
  id String @id @map("_id")

  accountId  String
  providerId String

  accessToken  String?
  refreshToken String?
  idToken      String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?

  scope    String?
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id])
}

model Verification {
  id         String @id @map("_id")
  identifier String
  value      String

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

model Journal {
  id     String @id @map("_id")
  name   String
  issn   String @unique
  status JournalStatus @default(ACTIVE)

  volumes Volume[]
}

model Volume {
  id           String @id @map("_id")
  volumeNumber Int
  year         Int

  coverImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status issue_status @default(DRAFT)

  journalId String
  journal   Journal @relation(fields: [journalId], references: [id])

  issues Issue[]

  @@unique([journalId, year, volumeNumber])
}

model Article {
  id String @id @map("_id")

  title       String
  abstract    String
  fileUrl     String
  coverImage  String?
  keywords    String?
  status      article_status @default(SUBMITTED)

  issueOrder Int?
  slug       String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editorId String?
  editor   User? @relation("EditorArticles", fields: [editorId], references: [id])

  issueId String?
  issue   Issue? @relation(fields: [issueId], references: [id])

  authors ArticleAuthor[]
  payment Payment?
  reviews Review[]
}

model ArticleAuthor {
  id String @id @map("_id")

  articleId String
  authorId  String

  authorOrder Int
  isCorresponding Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id])
  user    User    @relation(fields: [authorId], references: [id])

  @@unique([articleId, authorId])
  @@unique([articleId, authorOrder])
}

model CarouselSlide {
  id String @id @map("_id")

  image       String
  title       String
  description String
  buttons     String

  status    carouselslide_status @default(DRAFT)
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Issue {
  id String @id @map("_id")

  issueNumber     Int
  publicationDate DateTime?
  status          issue_status @default(DRAFT)

  coverImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  volumeId String
  volume   Volume @relation(fields: [volumeId], references: [id])

  articles Article[]

  @@unique([volumeId, issueNumber])
}

model Payment {
  id String @id @map("_id")

  articleId String @unique

  razorpayOrderId String
  amount Float
  currency String
  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id])
}

model Review {
  id String @id @map("_id")

  articleId  String
  reviewerId String

  comments       String
  recommendation String

  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id])
  user    User    @relation(fields: [reviewerId], references: [id])

  @@index([articleId])
  @@index([reviewerId])
}

model Testimonial {
  id String @id @map("_id")

  quote       String
  designation String?
  imageUrl    String?

  status testimonial_status @default(PENDING)

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
}

enum Role {
  AUTHOR
  REVIEWER
  EDITOR
  ADMIN
}

enum JournalStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  Male
  Female
  OTHER
}

enum issue_status {
  DRAFT
  PUBLISHED
}

enum testimonial_status {
  PENDING
  APPROVED
  REJECTED
}

enum carouselslide_status {
  DRAFT
  HIDE
  SHOW
}

enum article_status {
  SUBMITTED
  UNDER_REVIEW
  REVISION
  ACCEPTED
  REJECTED
  PUBLISHED
}
